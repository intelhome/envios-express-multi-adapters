#========================#
# CONFIGURACION SERVICIO #
#========================#
PORT=4010
RESTORE_SESSIONS_ON_START_UP=true
APP_URL=http://localhost:4010
LOG_LEVEL=info

#========================#
# CONFIGURACION DE MONGO #
#========================#
MONGODB_URL=mongodb://127.0.0.1:27017/whatsapp_api
MONGO_DB_NAME=registros_whatsapp
COLLECTION_SESSIONS_NAME=registros_whatsapp
MONGO_MAX_POOL_SIZE=20

#============================#
# CONFIGURACION DE PROVEEDOR #
#============================#
WHATSAPP_PROVIDER=baileys

#=========================#
# SEGURIDAD / ACCESO API  #
#=========================#
# Switch: en true exige el token 
REQUIRE_API_TOKEN=true
# Token compartido que deben enviar los consumidores (ej. SIGCENTER) en el
# header X-Api-Key para /api/*, y como ?token= al abrir /scan (y por Socket.IO).
# Solo aplica si REQUIRE_API_TOKEN=true.
API_ACCESS_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio
# Orígenes permitidos para CORS (Express y Socket.IO), separados por coma.
ALLOWED_ORIGINS=http://localhost
# Mínimo de milisegundos entre dos envíos consecutivos en la misma sesión.
MESSAGE_MIN_INTERVAL_MS=1200
# Límite de tamaño de body/JSON aceptado.
BODY_LIMIT=20mb

#===========================================#
# WEBHOOK DE MENSAJES ENTRANTES (opcional)   #
#===========================================#
# Reenvía los mensajes recibidos (receive_messages: true) a un sistema externo.
# Si este despliegue NO debe reenviar mensajes a ningún sistema (ej. es una
# instalación distinta, como la del "otro sistema"), deja estas 4 sin configurar.
# INCOMING_MSG_WEBHOOK_HOSTNAME=
# INCOMING_MSG_WEBHOOK_PATH=/response-baileys
# INCOMING_MSG_WEBHOOK_PROTOCOL=https
# INCOMING_MSG_WEBHOOK_EMPRESA_LABEL=

#====================================#
# HOOK ESTADO DE SESION -> SIGCENTER #
#====================================#
# Notifica a SIGCENTER cuando una sesión se conecta/desconecta. 
# SIGCENTER_HOOK_PROTOCOL=http
# SIGCENTER_HOOK_HOSTNAME=
# SIGCENTER_HOOK_PORT=80
# SIGCENTER_HOOK_PATH=/SIGCENTER/restful/hook-crm/estado-sesion-whatsapp
# SIGCENTER_HOOK_TOKEN=
